  OPTIONS()
  as -- Staging: light cleaning and renaming only. No business logic here.
--
-- Column names below reflect how BigQuery's CSV autodetect typically
-- normalizes the Kaggle "Sample Superstore" headers (spaces/hyphens become
-- underscores, e.g. "Sub-Category" -> Sub_Category). Verify against your
-- actual uploaded table's schema tab before running -- if BigQuery detected
-- slightly different names, adjust the mapping below to match.

with source as (

    select * from `your-gcp-project-id`.`superstore_raw`.`orders_raw`

),

renamed as (

    select
        Row_ID                as row_id,
        Order_ID              as order_id,
        -- BigQuery's CSV autodetect often recognizes M/D/YYYY dates and
        -- types these columns as DATE automatically -- in which case this
        -- passthrough is correct as-is. If autodetect instead left them as
        -- STRING, swap the line for:
        --   parse_date('%m/%d/%Y', Order_Date) as order_date
        Order_Date             as order_date,
        Ship_Date              as ship_date,
        Ship_Mode              as ship_mode,
        Customer_ID            as customer_id,
        Customer_Name          as customer_name,
        Segment                as segment,
        Country                as country,
        City                   as city,
        State                  as state,
        Region                 as region,
        Product_ID             as product_id,
        Category               as category,
        Sub_Category           as sub_category,
        Product_Name           as product_name,
        cast(Sales as float64)     as sales,
        cast(Quantity as int64)    as quantity,
        cast(Discount as float64)  as discount,
        cast(Profit as float64)    as profit

    from source
    where Order_ID is not null

)

select * from renamed;


